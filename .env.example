# Raw CSV files
HIRED_EMPLOYEES_FILE="data/raw/hired_employees.csv"
DEPARTMENTS_FILE="data/raw/departments.csv"
JOBS_FILE="data/raw/jobs.csv"

# PostgreSQL connection. The password is read from ~/.pgpass, never from this file.
PGHOST=localhost
PGPORT=5432
PGDATABASE=data_migration_poc
PGUSER=your_user

# Folder for AVRO backups
BACKUP_DIR=backups

# Password for the PostgreSQL container (docker compose only)
POSTGRES_PASSWORD='change_me'
