# Copy to ~/.config/data-migration-pilot.env (chmod 600). Never commit real values.

# Folder with the project data, outside the repository (client data).
# Use an absolute path: "~" is not expanded.
DATAWORK_DIR=/Users/your_user/DataWork/data-migration-pilot

# Raw CSV files
HIRED_EMPLOYEES_FILE="${DATAWORK_DIR}/raw/hired_employees (1).csv"
DEPARTMENTS_FILE="${DATAWORK_DIR}/raw/departments.csv"
JOBS_FILE="${DATAWORK_DIR}/raw/jobs.csv"

# PostgreSQL connection (setup without Docker)
PGHOST=localhost
PGPORT=5432
PGDATABASE=data_migration_poc
PGUSER=your_user
PGPASSWORD='change_me'

# Folder for AVRO backups (setup without Docker)
BACKUP_DIR="${DATAWORK_DIR}/backups"

# Password for the PostgreSQL container (docker compose only)
POSTGRES_PASSWORD='change_me'
